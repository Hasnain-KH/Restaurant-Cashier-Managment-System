{
  "name": "joona-biryani",
  "productName": "Joona Biryani",
  "version": "1.0.0",
  "description": "Offline sales management software for Joona Biryani",
  "main": "electron/main.js",
  "author": "Joona Biryani",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n CLIENT,APP -c cyan,yellow \"npm:dev:client\" \"npm:dev:electron\"",
    "dev:client": "vite --config client/vite.config.js",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env JOONA_DEV=1 electron .",
    "build": "vite build --config client/vite.config.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "test": "node --test \"tests/*.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^45.3.1",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "build": {
    "appId": "pk.joonabiryani.sales",
    "productName": "Joona Biryani",
    "copyright": "Copyright © 2026 Joona Biryani",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Joona-Biryani-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Joona Biryani"
    }
  }
}
